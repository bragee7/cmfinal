<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed-visible cancel for the SOS alarm notification (PowerGuardService).
     RemoteViews-safe widgets only. The Cancel button fires the SAME
     alarmCancelPi() PendingIntent as the expanded "Cancel SOS" action, so no
     chevron-expansion is needed on the lock screen. Display only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/notif_alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ZELDA SOS TRIGGERED"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/notif_alarm_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Recording starts automatically"
        android:textSize="13sp"
        android:textColor="#E0E0E0" />

    <Button
        android:id="@+id/notif_cancel_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Cancel SOS"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:background="#B71C1C" />

</LinearLayout>
